<?php
/** @var \Stimmwerk\App $app */
/** @var callable $t */
/** @var array $categories */
/** @var list<string> $errors */
/** @var array $old */
/** @var bool $postedToday */
use Stimmwerk\Core\Clock;
use Stimmwerk\Domain\TopicService;

$lang = $app->i18n->lang();
?>
<h1><?= e($t('topic.new_title')) ?></h1>
<p class="muted"><?= e($t('topic.new_intro')) ?></p>

<?php if ($postedToday): ?>
  <div class="flash flash-info">
    <?= e($t('topic.posted_today')) ?>
    <span class="countdown" data-countdown-to="<?= e(Clock::nextLocalMidnightUtcStr()) ?>" data-label="<?= e($t('topic.next_in')) ?>"></span>
  </div>
<?php else: ?>

<?php if ($errors !== []): ?>
  <div class="flash flash-error" role="alert">
    <ul class="plain-list">
      <?php foreach ($errors as $error): ?><li><?= e($t($error)) ?></li><?php endforeach; ?>
    </ul>
  </div>
<?php endif; ?>

<form class="card form-stack" method="post" action="/topics">
  <?= $app->csrf->field() ?>
  <label>
    <span><?= e($t('topic.f_title')) ?></span>
    <input type="text" name="title" required minlength="<?= TopicService::TITLE_MIN ?>" maxlength="<?= TopicService::TITLE_MAX ?>" value="<?= e((string) $old['title']) ?>">
  </label>
  <label>
    <span><?= e($t('topic.f_goal')) ?></span>
    <textarea name="goal" rows="3" required minlength="<?= TopicService::GOAL_MIN ?>" maxlength="<?= TopicService::GOAL_MAX ?>"><?= e((string) $old['goal']) ?></textarea>
  </label>
  <label>
    <span><?= e($t('topic.f_reasoning')) ?></span>
    <textarea name="reasoning" rows="6" required minlength="<?= TopicService::REASONING_MIN ?>" maxlength="<?= TopicService::REASONING_MAX ?>"><?= e((string) $old['reasoning']) ?></textarea>
  </label>
  <div class="form-row">
    <label>
      <span><?= e($t('topic.f_category')) ?></span>
      <select name="category_id" required>
        <option value=""><?= e($t('topic.f_choose')) ?></option>
        <?php foreach ($categories as $category): ?>
        <option value="<?= (int) $category['id'] ?>" <?= (int) $old['category_id'] === (int) $category['id'] ? 'selected' : '' ?>>
          <?= e($lang === 'de' ? (string) $category['name_de'] : (string) $category['name_en']) ?>
        </option>
        <?php endforeach; ?>
      </select>
    </label>
    <label>
      <span><?= e($t('topic.f_scope_level')) ?></span>
      <select name="scope_level" required>
        <?php foreach (TopicService::SCOPE_LEVELS as $level): ?>
        <option value="<?= e($level) ?>" <?= (string) $old['scope_level'] === $level ? 'selected' : '' ?>><?= e($t('scope.' . $level)) ?></option>
        <?php endforeach; ?>
      </select>
    </label>
    <label>
      <span><?= e($t('topic.f_scope_name')) ?></span>
      <input type="text" name="scope_name" maxlength="<?= TopicService::SCOPE_NAME_MAX ?>" value="<?= e((string) $old['scope_name']) ?>" list="scope-suggestions">
      <small class="muted"><?= e($t('topic.f_scope_name_hint')) ?></small>
    </label>
  </div>
  <datalist id="scope-suggestions">
    <?php foreach (['Baden-Württemberg', 'Bayern', 'Berlin', 'Brandenburg', 'Bremen', 'Hamburg', 'Hessen', 'Mecklenburg-Vorpommern', 'Niedersachsen', 'Nordrhein-Westfalen', 'Rheinland-Pfalz', 'Saarland', 'Sachsen', 'Sachsen-Anhalt', 'Schleswig-Holstein', 'Thüringen'] as $stateName): ?>
    <option value="<?= e($stateName) ?>"></option>
    <?php endforeach; ?>
  </datalist>
  <div>
    <button type="submit" class="btn btn-primary"><?= e($t('topic.submit')) ?></button>
  </div>
</form>
<?php endif; ?>
