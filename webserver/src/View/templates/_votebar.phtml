<?php
/**
 * Abstimmungsbalken. Erwartet: $app, $t, $barFor (int), $barAgainst (int).
 * Breiten über quantisierte Klassen (w-0..w-100) statt Inline-Styles, damit
 * die strikte CSP (style-src 'self', kein unsafe-inline) eingehalten wird.
 * Bedeutung hängt nie an Farbe allein: beide Segmente sind beschriftet.
 */
$barTotal = $barFor + $barAgainst;
$pctFor = $barTotal > 0 ? (int) round($barFor * 100 / $barTotal) : 0;
$pctAgainst = $barTotal > 0 ? 100 - $pctFor : 0;
?>
<div class="votebar-wrap">
  <?php if ($barTotal === 0): ?>
    <p class="muted"><?= e($t('vote.none_yet')) ?></p>
  <?php else: ?>
    <div class="votebar" role="img" aria-label="<?= e($t('vote.bar_aria')) ?>: <?= e($t('vote.for')) ?> <?= e($app->i18n->num($barFor)) ?>, <?= e($t('vote.against')) ?> <?= e($app->i18n->num($barAgainst)) ?>">
      <?php if ($barFor > 0): ?><span class="votebar-for w-<?= $pctFor ?>"></span><?php endif; ?>
      <?php if ($barAgainst > 0): ?><span class="votebar-against w-<?= $pctAgainst ?>"></span><?php endif; ?>
    </div>
    <div class="votebar-legend">
      <span><span class="dot dot-for" aria-hidden="true"></span><?= e($t('vote.for')) ?> <?= $pctFor ?> % · <?= e($app->i18n->num($barFor)) ?></span>
      <span><span class="dot dot-against" aria-hidden="true"></span><?= e($t('vote.against')) ?> <?= $pctAgainst ?> % · <?= e($app->i18n->num($barAgainst)) ?></span>
    </div>
  <?php endif; ?>
</div>
