<?php
/** @var \Stimmwerk\App $app */
/** @var callable $t */
/** @var array $user */
/** @var string $shortId */
/** @var array $voted */
/** @var array $authored */
/** @var array $favorites */
/** @var array $myReports */
/** @var array|null $duty */
/** @var array|null $upcoming */
use Stimmwerk\Core\Clock;

$lang = $app->i18n->lang();
$dateFormat = $t('common.date_format');
$dtFormat = $t('common.datetime_format');
$reportStatusKey = static fn (string $status): string => match ($status) {
    'pending'         => 'me.report_pending',
    'voting'          => 'me.report_voting',
    'decided_removed' => 'me.report_removed',
    default           => 'me.report_kept',
};
?>
<div class="page-head">
  <h1><?= e($t('me.title')) ?></h1>
</div>

<section class="card id-card">
  <div>
    <span class="field-label"><?= e($t('me.short_id')) ?></span>
    <span class="id-value"><?= e($shortId) ?></span>
  </div>
  <span class="muted"><?= e($t('me.since', ['date' => Clock::displayLocal((string) $user['created_at'], $dateFormat)])) ?></span>
  <?php if ($user['jury_cooldown_until'] !== null && (string) $user['jury_cooldown_until'] > Clock::nowStr()): ?>
    <span class="muted"><?= e($t('me.cooldown', ['date' => Clock::displayLocal((string) $user['jury_cooldown_until'], $dtFormat)])) ?></span>
  <?php endif; ?>
</section>

<section>
  <h2><?= e($t('me.sec_jury')) ?></h2>
  <?php if ($duty !== null): ?>
    <div class="flash flash-info"><?= e($t('me.jury_pending')) ?> <a href="<?= base_path() ?>/jury"><?= e($t('me.jury_go')) ?></a></div>
  <?php elseif ($upcoming !== null): ?>
    <p class="muted"><?= e($t('me.jury_upcoming', ['date' => Clock::displayLocal((string) $upcoming['voting_starts_at'], $dateFormat)])) ?></p>
  <?php else: ?>
    <p class="muted"><?= e($t('me.jury_none')) ?></p>
  <?php endif; ?>
</section>

<section>
  <h2><?= e($t('me.sec_votes')) ?></h2>
  <?php if ($voted === []): ?>
    <p class="muted"><?= e($t('me.none')) ?></p>
  <?php else: ?>
  <ul class="row-list">
    <?php foreach ($voted as $row): ?>
    <li class="row-item">
      <div class="row-main">
        <?php if ($row['status'] === 'active'): ?>
          <a href="<?= base_path() ?>/topic/<?= (int) $row['id'] ?>"><?= e((string) $row['title']) ?></a>
        <?php else: ?>
          <span class="muted"><?= e((string) $row['title']) ?> (<?= e($t('me.status_removed')) ?>)</span>
        <?php endif; ?>
        <span class="badge badge-muted"><?= e($lang === 'de' ? (string) $row['name_de'] : (string) $row['name_en']) ?></span>
      </div>
      <div class="row-side">
        <span class="dot <?= $row['my_choice'] === 'for' ? 'dot-for' : 'dot-against' ?>" aria-hidden="true"></span>
        <?= e($t($row['my_choice'] === 'for' ? 'vote.for' : 'vote.against')) ?>
        <span class="muted">· <?= e($app->i18n->num((int) $row['votes_for'])) ?> / <?= e($app->i18n->num((int) $row['votes_against'])) ?></span>
      </div>
    </li>
    <?php endforeach; ?>
  </ul>
  <?php endif; ?>
</section>

<section>
  <h2><?= e($t('me.sec_topics')) ?></h2>
  <?php if ($authored === []): ?>
    <p class="muted"><?= e($t('me.none')) ?></p>
  <?php else: ?>
  <ul class="row-list">
    <?php foreach ($authored as $row): ?>
    <li class="row-item">
      <div class="row-main">
        <a href="<?= base_path() ?>/topic/<?= (int) $row['id'] ?>"><?= e((string) $row['title']) ?></a>
        <span class="badge <?= $row['status'] === 'active' ? 'badge-muted' : 'badge-danger' ?>">
          <?= e($t($row['status'] === 'active' ? 'me.status_active' : 'me.status_removed')) ?>
        </span>
      </div>
      <div class="row-side muted">
        <?= e(Clock::displayLocal((string) $row['created_at'], $dateFormat)) ?>
        · <?= e($app->i18n->num((int) $row['votes_for'])) ?> / <?= e($app->i18n->num((int) $row['votes_against'])) ?>
      </div>
    </li>
    <?php endforeach; ?>
  </ul>
  <?php endif; ?>
</section>

<section>
  <h2><?= e($t('me.sec_favorites')) ?></h2>
  <?php if ($favorites === []): ?>
    <p class="muted"><?= e($t('me.none')) ?></p>
  <?php else: ?>
  <ul class="row-list">
    <?php foreach ($favorites as $favorite): ?>
    <li class="row-item">
      <div class="row-main">
        <span class="badge badge-muted"><?= e($t($favorite['kind'] === 'category' ? 'me.fav_category' : 'me.fav_scope')) ?></span>
        <?php if ($favorite['kind'] === 'category'): ?>
          <a href="<?= base_path() ?>/topics?category=<?= e(rawurlencode((string) $favorite['ref'])) ?>">
            <?= e($lang === 'de' ? (string) ($favorite['name_de'] ?? $favorite['ref']) : (string) ($favorite['name_en'] ?? $favorite['ref'])) ?>
          </a>
        <?php else: ?>
          <?php
            $scopeParts = explode(':', (string) $favorite['ref'], 2);
            $favLabel = $t('scope.' . $scopeParts[0]) . (isset($scopeParts[1]) ? ': ' . $scopeParts[1] : '');
            $favQuery = isset($scopeParts[1])
                ? 'level=' . rawurlencode($scopeParts[0]) . '&scope=' . rawurlencode($scopeParts[1])
                : 'level=' . rawurlencode($scopeParts[0]);
          ?>
          <a href="<?= base_path() ?>/topics?<?= e($favQuery) ?>"><?= e($favLabel) ?></a>
        <?php endif; ?>
      </div>
      <div class="row-side">
        <form method="post" action="<?= base_path() ?>/favorite">
          <?= $app->csrf->field() ?>
          <input type="hidden" name="kind" value="<?= e((string) $favorite['kind']) ?>">
          <input type="hidden" name="ref" value="<?= e((string) $favorite['ref']) ?>">
          <input type="hidden" name="return" value="/me">
          <button type="submit" class="btn btn-ghost btn-sm"><?= e($t('me.unfav')) ?></button>
        </form>
      </div>
    </li>
    <?php endforeach; ?>
  </ul>
  <?php endif; ?>
</section>

<section>
  <h2><?= e($t('me.sec_reports')) ?></h2>
  <?php if ($myReports === []): ?>
    <p class="muted"><?= e($t('me.none')) ?></p>
  <?php else: ?>
  <ul class="row-list">
    <?php foreach ($myReports as $report): ?>
    <li class="row-item">
      <div class="row-main">
        <a href="<?= base_path() ?>/topic/<?= (int) $report['topic_id'] ?>"><?= e((string) $report['title']) ?></a>
      </div>
      <div class="row-side muted">
        <?= e($t($reportStatusKey((string) $report['status']))) ?>
        · <?= e(Clock::displayLocal((string) $report['created_at'], $dateFormat)) ?>
      </div>
    </li>
    <?php endforeach; ?>
  </ul>
  <?php endif; ?>
</section>

<section class="card danger-zone">
  <h2><?= e($t('me.delete_title')) ?></h2>
  <p class="muted"><?= e($t('me.delete_text')) ?></p>
  <form method="post" action="<?= base_path() ?>/account/delete" class="form-stack">
    <?= $app->csrf->field() ?>
    <label class="check-label">
      <input type="checkbox" name="confirm" value="yes" required>
      <span><?= e($t('me.delete_confirm')) ?></span>
    </label>
    <div><button type="submit" class="btn btn-danger"><?= e($t('me.delete_button')) ?></button></div>
  </form>
</section>
