<?php
/** @var \Stimmwerk\App $app */
/** @var callable $t */
/** @var array $rows */
/** @var int $total */
/** @var int $page */
/** @var int $pages */
/** @var array $filters */
/** @var array $categories */
$lang = $app->i18n->lang();
$baseQuery = static function (array $overrides) use ($filters): string {
    $params = array_filter(array_merge($filters, $overrides), static fn ($v) => $v !== '' && $v !== null);
    return $params === [] ? '' : '?' . http_build_query($params);
};
?>
<div class="page-head">
  <h1><?= e($t('topics.title')) ?></h1>
  <span class="muted"><?= e($t('topics.count', ['n' => $app->i18n->num($total)])) ?></span>
</div>

<form class="filter-bar" method="get" action="<?= base_path() ?>/topics">
  <label>
    <span><?= e($t('topics.filter_category')) ?></span>
    <select name="category">
      <option value=""><?= e($t('topics.filter_all')) ?></option>
      <?php foreach ($categories as $category): ?>
      <option value="<?= e((string) $category['slug']) ?>" <?= $filters['category'] === $category['slug'] ? 'selected' : '' ?>>
        <?= e($lang === 'de' ? (string) $category['name_de'] : (string) $category['name_en']) ?>
      </option>
      <?php endforeach; ?>
    </select>
  </label>
  <label>
    <span><?= e($t('topics.filter_level')) ?></span>
    <select name="level">
      <option value=""><?= e($t('topics.filter_all')) ?></option>
      <?php foreach (\Stimmwerk\Domain\TopicService::SCOPE_LEVELS as $level): ?>
      <option value="<?= e($level) ?>" <?= $filters['level'] === $level ? 'selected' : '' ?>><?= e($t('scope.' . $level)) ?></option>
      <?php endforeach; ?>
    </select>
  </label>
  <label>
    <span><?= e($t('topics.search')) ?></span>
    <input type="search" name="q" maxlength="80" value="<?= e($filters['q']) ?>">
  </label>
  <label>
    <span><?= e($t('topics.sort')) ?></span>
    <select name="sort">
      <option value="new" <?= $filters['sort'] === 'new' ? 'selected' : '' ?>><?= e($t('topics.sort_new')) ?></option>
      <option value="top" <?= $filters['sort'] === 'top' ? 'selected' : '' ?>><?= e($t('topics.sort_top')) ?></option>
    </select>
  </label>
  <button type="submit" class="btn btn-outline"><?= e($t('topics.apply')) ?></button>
</form>

<?php if ($rows === []): ?>
  <p class="muted"><?= e($t('topics.none')) ?></p>
<?php else: ?>
  <div class="topic-grid">
    <?php foreach ($rows as $row): ?>
      <?php require __DIR__ . '/_topic_card.phtml'; ?>
    <?php endforeach; ?>
  </div>
<?php endif; ?>

<?php if ($pages > 1): ?>
<nav class="pagination" aria-label="Pagination">
  <?php if ($page > 1): ?>
    <a class="btn btn-ghost btn-sm" href="<?= base_path() ?>/topics<?= e($baseQuery(['page' => $page - 1])) ?>">&laquo; <?= e($t('topics.prev')) ?></a>
  <?php endif; ?>
  <span class="muted"><?= e($t('topics.page_of', ['p' => $page, 'n' => $pages])) ?></span>
  <?php if ($page < $pages): ?>
    <a class="btn btn-ghost btn-sm" href="<?= base_path() ?>/topics<?= e($baseQuery(['page' => $page + 1])) ?>"><?= e($t('topics.next')) ?> &raquo;</a>
  <?php endif; ?>
</nav>
<?php endif; ?>
