# Stimmwerk – Apache/LiteSpeed-Konfiguration (Installation im Webroot oder Unterordner)
Options -Indexes -MultiViews
DirectoryIndex index.php

# Alle nicht existierenden Pfade an den Front-Controller. Die Kennung
# SW_CLEAN_URLS meldet der Anwendung, dass saubere Pfade funktionieren;
# fehlt sie (kein mod_rewrite / .htaccess ignoriert), erzeugt die Anwendung
# automatisch Links im Stil /index.php/... , die überall laufen.
<IfModule mod_rewrite.c>
    RewriteEngine On
    SetEnv SW_CLEAN_URLS 1
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Interne Dateien niemals ausliefern (zusätzlich zu den Sperren in den
# Unterverzeichnissen src/, config/, db/, data/, bin/)
<FilesMatch "\.(md|sql|sqlite|sqlite-wal|sqlite-shm|log|key|phtml|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Versteckte Dateien (.gitignore u. a.) niemals ausliefern
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
