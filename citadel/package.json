  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "otpauth": "^9.3.6",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.5",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
