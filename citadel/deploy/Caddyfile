# Replace the site address and email, then `docker compose up -d`.
# Caddy provisions and renews certificates automatically (ACME) and
# negotiates modern TLS (1.2/1.3) with strong ciphers by default.
{
	email admin@example.com
}

your-domain.example {
	encode zstd gzip
	reverse_proxy app:8787

	# HSTS is emitted by the app; TLS + cert automation is Caddy's job.
	header -Server
}
