# Copy to .env and fill in. Never commit .env.
NODE_ENV=production

# Bind address. Keep on loopback and terminate TLS in the reverse proxy.
HOST=127.0.0.1
PORT=8787

# Public origin the browser reaches (used for TOTP issuer + strict Origin checks).
PUBLIC_ORIGIN=https://localhost

# 32-byte key (base64) that encrypts TOTP secrets at rest. Generate: npm run keygen
KEK_BASE64=

# Set false only for local http development.
COOKIE_SECURE=true

# Trust X-Forwarded-* from the reverse proxy (Caddy). 1 = one proxy hop.
TRUST_PROXY=1

# Allow self-service registration. Set false to lock the instance after bootstrap.
ALLOW_REGISTRATION=true
